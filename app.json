{
  "expo": {
    "name": "TunedTV",
    "slug": "TunedTV",
    "version": "1.0.19",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tunedtv",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.tunedtv.app",
      "icon": "./assets/images/icon.png",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "TunedTV does not read your photos. iOS shows this only if you choose a photo to upload in the app.",
        "NSLocalNetworkUsageDescription": "TunedTV finds your TV and cable or TV box on your Wi-Fi so it can change the channel, open an app, or work as your remote.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSBonjourServices": [
          "_googlecast._tcp",
          "_androidtvremote2._tcp",
          "_companion-link._tcp",
          "_airplay._tcp",
          "_raop._tcp",
          "_tivo-remote._tcp",
          "_tivo-device._tcp",
          "_samsungmsf._tcp",
          "_viziocast._tcp",
          "_amzn-wplay._tcp",
          "_roku-rcp._tcp",
          "_http._tcp"
        ],
        "INAlternativeAppNames": [
          {
            "INAlternativeAppName": "Tuner",
            "INAlternativeAppNamePronunciationHint": "too ner"
          },
          {
            "INAlternativeAppName": "Tuned",
            "INAlternativeAppNamePronunciationHint": "toond"
          }
        ]
      },
      "associatedDomains": [
        "applinks:tunedtv.com"
      ],
      "appleTeamId": "H8R3K9P5AC"
    },
    "android": {
      "package": "com.tunedtv.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#1d2025"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-notifications",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.585609408161-7clkl3840gq1j05k9pc2jl36mcumsi60"
        }
      ],
      "./plugins/withGoogleSignInNonce.js",
      "./plugins/withModularHeaders.js",
      "./plugins/withLocalNetworkHttp.js",
      "./plugins/withAskTunedTV.js",
      "@bacons/apple-targets",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "TunedTV listens when you tap the mic so you can say what to watch, like \"put on the Knicks game\".",
          "speechRecognitionPermission": "TunedTV turns what you say into a request, like \"put on the Knicks game\", to find it and put it on your TV."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "dc41ee5b-266b-4f94-9c02-cd1c6c7b79ee"
      }
    },
    "owner": "spcecwby",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/dc41ee5b-266b-4f94-9c02-cd1c6c7b79ee"
    }
  }
}
