{
  "expo": {
    "name": "TunedTV",
    "slug": "TunedTV",
    "version": "1.0.14",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tunedtv",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.tunedtv.app",
      "icon": "./assets/images/icon.png",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "TunedTV finds your DIRECTV receiver or Roku on your Wi-Fi so it can change the channel or open an app on your TV.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.tunedtv.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#1d2025"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-notifications",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.585609408161-7clkl3840gq1j05k9pc2jl36mcumsi60"
        }
      ],
      "./plugins/withGoogleSignInNonce.js",
      "./plugins/withModularHeaders.js",
      "./plugins/withLocalNetworkHttp.js"
    ],
    "extra": {
      "eas": {
        "projectId": "dc41ee5b-266b-4f94-9c02-cd1c6c7b79ee"
      }
    },
    "owner": "spcecwby",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/dc41ee5b-266b-4f94-9c02-cd1c6c7b79ee"
    }
  }
}
